# Copy to deploy/.env for local staging compose. Never commit real secrets.
MSSQL_SA_PASSWORD=ChangeMe_Str0ng_Password!
AUTH_SIGNING_KEY=replace-with-at-least-32-char-random-signing-key
AUTH_OTP_HASH_KEY=replace-with-at-least-32-char-random-otp-hash-key
CORS_ORIGIN=http://localhost:8081

# Optional production-style overrides (set in host/Key Vault, not in git):
# ConnectionStrings__ProDoc=
# Payments__Provider=Razorpay
# Payments__RazorpayKeyId=
# Payments__RazorpayKeySecret=
# Payments__RazorpayWebhookSecret=
# Ai__Provider=OpenAI
# Ai__ApiKey=
# PRODOC_MIGRATE=false
